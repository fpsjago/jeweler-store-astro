---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  id: string;
  name: string;
  price: string;
  category: string;
  image: ImageMetadata;
  /** Responsive `sizes` for the photo; defaults to a 1-col / 2-col / 3-col grid. */
  sizes?: string;
  /** Load eagerly (set for cards that sit above the fold). */
  eager?: boolean;
}

const {
  id,
  name,
  price,
  category,
  image,
  sizes = '(max-width: 768px) calc(100vw - 64px), (max-width: 1024px) calc(50vw - 100px), 400px',
  eager = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<a href={`${base}products/${id}/`} class="product-card" data-category={category} data-reveal>
  <div class="product-image" transition:name={`product-${id}`}>
    <Picture
      src={image}
      alt={name}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[360, 540, 720]}
      sizes={sizes}
      width={720}
      height={540}
      fit="cover"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="product-info">
    <p class="category">{category}</p>
    <h3><span class="name">{name}</span></h3>
    <p class="price">{price}</p>
  </div>
</a>

<style>
  .product-card {
    display: block;
    background-color: var(--surface);
    border-radius: 2px;
    transition: box-shadow 0.6s var(--ease-out);
  }

  .product-card:hover,
  .product-card:focus-visible {
    box-shadow: var(--shadow-lift);
  }

  .product-image {
    aspect-ratio: 4 / 3;
    background-color: var(--cream);
    overflow: hidden;
    border-radius: 2px 2px 0 0;
  }

  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .product-card:hover .product-image :global(img),
  .product-card:focus-visible .product-image :global(img) {
    transform: scale(1.05);
  }

  .product-info {
    padding: var(--spacing-md);
    text-align: center;
    transition: translate 0.6s var(--ease-out);
  }

  .product-card:hover .product-info,
  .product-card:focus-visible .product-info {
    translate: 0 -0.35rem;
  }

  .category {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--spacing-xs);
  }

  .product-info h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-xs);
  }

  /* A gold hairline draws in under the name on hover / keyboard focus. */
  .name {
    padding-bottom: 0.2em;
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 50% 100% / 0% 1px;
    transition: background-size 0.6s var(--ease-out);
  }

  .product-card:hover .name,
  .product-card:focus-visible .name {
    background-size: 100% 1px;
  }

  .price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--gold-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-image :global(img),
    .product-info,
    .name {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .product-info {
      padding: var(--spacing-sm);
    }

    .product-info h3 {
      font-size: 1.1rem;
    }
  }
</style>

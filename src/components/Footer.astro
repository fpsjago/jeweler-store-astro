---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-section">
        <p class="footer-brand">MAISON</p>
        <p>Exquisite handcrafted jewelry for discerning collectors since 2024.</p>
      </div>
      
      <div class="footer-section">
        <h2 class="footer-heading">Navigate</h2>
        <nav aria-label="Footer">
          <a href={base}>Home</a>
          <a href={`${base}collections/`}>Collections</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}contact/`}>Contact</a>
        </nav>
      </div>
      
      <div class="footer-section">
        <h2 class="footer-heading">Contact</h2>
        <p>hello@maison.example</p>
        <p>+1 (555) 123-4567</p>
      </div>
      
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} MAISON. All rights reserved.</p>
      <p class="credit">Template by <a href="https://www.fullstackevolved.com/?utm_source=template&utm_medium=footer&utm_campaign=maison" target="_blank" rel="noopener">FSEVO</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--black);
    color: var(--cream);
    padding: var(--spacing-xl) 0 var(--spacing-md);
    margin-top: var(--spacing-xl);
  }
  
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  
  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
    letter-spacing: 0.2em;
    color: var(--cream);
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: var(--spacing-sm);
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  
  .footer-section p:not(.footer-brand) {
    color: var(--warm-gray);
    margin-bottom: var(--spacing-xs);
  }
  
  .footer-section nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  
  .footer-section nav a {
    color: var(--warm-gray);
  }
  
  .footer-section nav a:hover {
    color: var(--gold);
  }
  
  
  
  
  .footer-bottom {
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(198, 168, 125, 0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--warm-gray);
  }
  
  .credit a {
    color: var(--gold);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .credit a:hover {
    color: var(--cream);
  }

  .footer :focus-visible {
    outline-color: var(--gold);
  }

  
  @media (max-width: 768px) {
    .container {
      padding: 0 var(--spacing-md);
    }
    
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: var(--spacing-xs);
      text-align: center;
    }
  }
</style>

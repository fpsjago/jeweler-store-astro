---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { resolveProductImage } from '../../lib/product-images';
import { categories } from '../../types';

// Get all products and sort by order
const allProducts = await getCollection('products');
const products = allProducts.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<BaseLayout title="Collections - MAISON">
  <section class="page-header" transition:animate="slide">
    <div class="container">
      <h1>Our Collections</h1>
      <p>Discover exquisite pieces crafted for life's most precious moments</p>
    </div>
  </section>

  <section class="collections" aria-labelledby="collections-heading">
    <div class="container">
      <h2 id="collections-heading" class="visually-hidden">All pieces</h2>
      <div class="filter-bar" role="group" aria-label="Filter by category">
        {categories.map((category) => (
          <button
            type="button"
            class="filter-btn"
            data-category={category}
            aria-pressed={category === 'All' ? 'true' : 'false'}
          >
            {category}
          </button>
        ))}
      </div>

      <p class="filter-status" role="status" aria-live="polite" data-filter-status>
        Showing all {products.length} pieces
      </p>

      <div class="product-grid" data-product-grid>
        {products.map((product, index) => (
          <ProductCard
            id={product.id}
            name={product.data.name}
            price={product.data.price}
            category={product.data.category}
            image={resolveProductImage(product.data.image)}
            eager={index < 3}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--surface);
    padding: var(--spacing-xl) 0;
    text-align: center;
    border-bottom: 1px solid var(--hairline);
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .page-header h1 {
    margin-bottom: var(--spacing-sm);
  }

  .page-header p {
    font-size: 1.1rem;
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .collections {
    padding: var(--spacing-xl) 0;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }

  .filter-btn {
    min-height: 44px;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--surface);
    color: var(--black);
    border: 1px solid rgba(10, 10, 10, 0.2);
    border-radius: 2px;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .filter-btn:hover {
    border-color: var(--gold-ink);
    color: var(--gold-ink);
  }

  .filter-btn[aria-pressed='true'] {
    background-color: var(--black);
    color: var(--cream);
    border-color: var(--black);
  }

  .filter-status {
    text-align: center;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--spacing-lg);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
  }

  .product-grid > :global([hidden]) {
    display: none;
  }

  /* Stagger the scroll reveal across a row of three. */
  .product-grid > :global(:nth-child(3n + 2)) { animation-range: entry 8% entry 78%; }
  .product-grid > :global(:nth-child(3n + 3)) { animation-range: entry 16% entry 86%; }

  @media (max-width: 768px) {
    .container {
      padding: 0 var(--spacing-md);
    }

    .product-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .filter-bar {
      gap: var(--spacing-xs);
    }

    .filter-btn {
      font-size: 0.85rem;
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<style is:global>
  /* Filter re-flow: cards glide to their new slots inside a same-document
     View Transition (html.is-filtering is set only for its duration). */
  html.is-filtering::view-transition-group(*) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Only the cards take part in the filter transition. Astro's own named
     elements (the slid page header, the photo morph names) sit it out. */
  html.is-filtering [data-astro-transition-scope] {
    view-transition-name: none !important;
  }

  html.is-filtering::view-transition-old(root),
  html.is-filtering::view-transition-new(root) {
    animation: none;
  }
</style>

<script>
  // Client-side filtering. Bound on astro:page-load so it survives
  // ClientRouter navigations (a module script only runs once per tab).
  // The newest filter transition. A rapid second click skips the first
  // transition; its cleanup must not strip the class and names the second
  // one still needs.
  let current: ViewTransition | null = null;

  function initFilter() {
    const grid = document.querySelector<HTMLElement>('[data-product-grid]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    if (!grid || !status || buttons.length === 0) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.product-card'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const apply = (category: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = category === 'All' || card.dataset.category === category;
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.category === category));
      }
      const noun = shown === 1 ? 'piece' : 'pieces';
      status.textContent =
        category === 'All' ? `Showing all ${shown} ${noun}` : `Showing ${shown} ${noun} in ${category}`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const category = button.dataset.category ?? 'All';
        if (!document.startViewTransition || reduceMotion.matches) {
          apply(category);
          return;
        }
        // Name each card for the duration of the transition so the whole card
        // (photo and caption together) glides, then hand the names back.
        cards.forEach((card, i) => card.style.setProperty('view-transition-name', `filter-card-${i}`));
        document.documentElement.classList.add('is-filtering');
        const transition = document.startViewTransition(() => apply(category));
        current = transition;
        transition.finished.finally(() => {
          if (current !== transition) return;
          current = null;
          document.documentElement.classList.remove('is-filtering');
          cards.forEach((card) => card.style.removeProperty('view-transition-name'));
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initFilter);
</script>

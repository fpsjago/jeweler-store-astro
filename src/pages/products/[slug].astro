---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveProductImage } from '../../lib/product-images';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const image = resolveProductImage(product.data.image);
// Both enquiry actions open the contact form with the piece pre-filled.
const contactHref = (intent: 'info' | 'viewing') =>
  `${base}contact/?piece=${encodeURIComponent(product.data.name)}&intent=${intent}#contact-form`;
---

<BaseLayout title={`${product.data.name} - MAISON`} description={product.data.description}>
  <article class="product-detail">
    <div class="container">
      <a href={`${base}collections/`} class="back-link">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 4 L6 10 L12 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Collections
      </a>
      
      <div class="product-layout">
        <div class="product-image-section">
          <div class="product-image-main">
            <div class="product-photo" transition:name={`product-${product.id}`}>
              <Picture
                src={image}
                alt={product.data.name}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[480, 720, 960]}
                sizes="(max-width: 768px) calc(100vw - 128px), (max-width: 1440px) calc(50vw - 200px), 560px"
                width={960}
                height={720}
                fit="cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
        
        <div class="product-info-section" transition:animate="slide">
          <p class="category">{product.data.category}</p>
          <h1>{product.data.name}</h1>
          <p class="price">{product.data.price}</p>
          
          <div class="description">
            <p>{product.data.description}</p>
          </div>
          
          <div class="details">
            <h2>Details</h2>
            <dl>
              <dt>Materials</dt>
              <dd>
                <ul>
                  {product.data.materials.map((material: string) => (
                    <li>{material}</li>
                  ))}
                </ul>
              </dd>
              
              <dt>Dimensions</dt>
              <dd>{product.data.dimensions}</dd>
            </dl>
          </div>
          
          <div class="actions">
            <a class="btn-primary" href={contactHref('info')}>Request Information</a>
            <a class="btn-secondary" href={contactHref('viewing')}>Schedule Viewing</a>
          </div>
          
          <div class="product-content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--muted);
    margin-bottom: var(--spacing-lg);
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }
  
  .back-link:hover {
    color: var(--gold-ink);
  }
  
  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }
  
  .product-image-section {
    position: sticky;
    top: 120px;
    height: fit-content;
  }
  
  .product-image-main {
    background-color: var(--surface);
    border-radius: 8px;
    padding: var(--spacing-md);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  
  .product-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
  }

  .product-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .product-image-main:hover .product-photo :global(img) {
    transform: scale(1.04);
  }
  
  .product-info-section {
    padding: var(--spacing-md) 0;
  }
  
  .category {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--spacing-xs);
  }
  
  .product-info-section h1 {
    margin-bottom: var(--spacing-sm);
  }
  
  .price {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--gold-ink);
    margin-bottom: var(--spacing-lg);
  }
  
  .description {
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--spacing-lg);
  }
  
  .description p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--muted);
  }
  
  .details {
    margin-bottom: var(--spacing-lg);
  }
  
  .details h2 {
    margin-bottom: var(--spacing-md);
    font-size: 1.25rem;
  }
  
  .details dl {
    display: grid;
    gap: var(--spacing-md);
  }
  
  .details dt {
    font-weight: 600;
    color: var(--black);
    margin-bottom: var(--spacing-xs);
  }
  
  .details dd {
    color: var(--muted);
  }
  
  .details ul {
    list-style: none;
  }
  
  .details li {
    padding-left: var(--spacing-sm);
    position: relative;
  }
  
  .details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 4px;
    height: 4px;
    background-color: var(--gold);
    border-radius: 50%;
  }
  
  .actions {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }
  
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .btn-primary {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-lg);
    background-color: var(--black);
    color: var(--cream);
    font-size: 1rem;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }
  
  .btn-primary:hover {
    background-color: var(--gold);
    color: var(--black);
  }
  
  .btn-secondary {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 2px solid var(--black);
    background: none;
    color: var(--black);
    font-size: 1rem;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }
  
  .btn-secondary:hover {
    background-color: var(--black);
    color: var(--cream);
  }
  
  .product-content {
    background-color: var(--surface);
    padding: var(--spacing-lg);
    border-radius: 4px;
    line-height: 1.8;
  }
  
  .product-content :global(h2) {
    font-size: 1.75rem;
    margin: var(--spacing-lg) 0 var(--spacing-md) 0;
    color: var(--black);
  }
  
  .product-content :global(h3) {
    font-size: 1.35rem;
    margin: var(--spacing-md) 0 var(--spacing-sm) 0;
    color: var(--black);
  }
  
  .product-content :global(h4) {
    font-size: 1.15rem;
    margin: var(--spacing-md) 0 var(--spacing-xs) 0;
    color: var(--black);
  }
  
  .product-content :global(p) {
    margin-bottom: var(--spacing-md);
    color: var(--muted);
  }
  
  .product-content :global(ul),
  .product-content :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-lg);
  }
  
  .product-content :global(li) {
    margin-bottom: var(--spacing-xs);
    color: var(--muted);
  }
  
  .product-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--spacing-md);
  }
  
  .product-content :global(th),
  .product-content :global(td) {
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--hairline);
    text-align: left;
  }
  
  .product-content :global(th) {
    background-color: var(--cream);
    font-weight: 600;
    color: var(--black);
  }
  
  .product-content :global(td) {
    color: var(--muted);
  }
  
  .product-content :global(strong) {
    color: var(--black);
    font-weight: 600;
  }
  
  @media (max-width: 768px) {
    .container {
      padding: var(--spacing-md);
    }
    
    .product-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
    
    .product-image-section {
      position: relative;
      top: 0;
    }
    
    .product-image-main {
      padding: var(--spacing-lg);
    }
    
    .actions {
      flex-direction: column;
    }
    
    .product-content {
      padding: var(--spacing-md);
    }
  }
</style>

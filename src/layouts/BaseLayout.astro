---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Exquisite handcrafted jewelry for discerning collectors' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <slot name="head" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Palette. Pale gold is an ornament colour (rules, icons, text on --black);
       --gold-ink is the gold you may set text in on light grounds (5:1 on cream). */
    --gold: #C6A87D;
    --gold-ink: #856532;
    --black: #0A0A0A;
    --cream: #FAF7F2;
    --surface: #FFFDF8;
    /* Secondary text on light grounds (5.3:1 on cream) */
    --muted: #6F6656;
    /* Secondary text on --black (7.2:1) */
    --warm-gray: #A39B8B;
    --hairline: rgba(10, 10, 10, 0.1);

    /* --font-display and --font-body come from the <Font /> tags above
       (self-hosted, with metric-matched fallbacks). */

    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;

    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.76, 0, 0.24, 1);
    --transition: 0.3s var(--ease-out);
    --shadow-lift:
      0 1px 2px rgba(64, 46, 20, 0.06),
      0 4px 10px rgba(64, 46, 20, 0.06),
      0 14px 28px rgba(64, 46, 20, 0.08),
      0 32px 64px rgba(64, 46, 20, 0.08);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--cream);
    color: var(--black);
    font-size: 18px;
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  p, li, dd {
    text-wrap: pretty;
  }

  h1 {
    font-size: 3.5rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 2.5rem;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: 1.75rem;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition), background-color var(--transition), border-color var(--transition), opacity var(--transition);
  }

  button {
    font-family: var(--font-body);
    border: none;
    cursor: pointer;
    transition: color var(--transition), background-color var(--transition), border-color var(--transition);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  :focus-visible {
    outline: 2px solid var(--black);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    background: var(--black);
    color: var(--cream);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
    outline-color: var(--gold);
  }

  /* Scroll-linked entry reveals. Opt in with data-reveal. Content is visible by
     default and only animates where scroll-driven animations are supported and
     the visitor has not asked for reduced motion. Only translate, scale and
     clip-path move, never opacity, so text keeps full contrast at every frame. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-reveal] {
        animation: reveal-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      [data-reveal='late'] {
        animation-range: entry 15% entry 85%;
      }

      [data-reveal='image'] {
        animation-name: reveal-image;
        animation-range: entry 0% cover 35%;
      }
    }
  }

  /* The end inset is negative so a finished reveal never clips the element's
     own shadow or focus ring (fill-mode keeps the last frame applied). */
  @keyframes reveal-rise {
    from {
      translate: 0 2.5rem;
      clip-path: inset(100% -8rem -8rem -8rem);
    }
    to {
      translate: 0 0;
      clip-path: inset(-8rem -8rem -8rem -8rem);
    }
  }

  @keyframes reveal-image {
    from {
      clip-path: inset(18% 0 0 0);
      scale: 1.08;
    }
    to {
      clip-path: inset(0 0 0 0);
      scale: 1;
    }
  }

  /* Responsive Typography */
  @media (max-width: 768px) {
    html {
      font-size: 16px;
    }

    h1 {
      font-size: 2.5rem;
    }

    h2 {
      font-size: 2rem;
    }

    h3 {
      font-size: 1.5rem;
    }
  }
</style>
